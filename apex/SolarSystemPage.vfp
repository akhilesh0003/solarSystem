<apex:page controller="SolarSystemController" showHeader="false" sidebar="false" standardStylesheets="false">
<!DOCTYPE html>
<html>
<head>
    <title>Solar System Explorer - Salesforce</title>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #030712;
            color: #fff;
            overflow: hidden;
            height: 100vh;
        }
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 24px;
            background: rgba(17, 24, 39, 0.8);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .header h1 { font-size: 1.25rem; font-weight: bold; }
        .header p { font-size: 0.875rem; color: #9ca3af; }
        .main-content { display: flex; height: calc(100vh - 57px); }
        .canvas-container { flex: 1; position: relative; }
        #solarCanvas { width: 100%; height: 100%; display: block; }
        .controls {
            position: absolute;
            bottom: 16px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(17, 24, 39, 0.9);
            backdrop-filter: blur(8px);
            border-radius: 9999px;
            padding: 12px 20px;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .btn {
            width: 40px; height: 40px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 50%;
            background: rgba(255,255,255,0.1);
            border: none; color: #fff; cursor: pointer;
            transition: background 0.2s;
        }
        .btn:hover { background: rgba(255,255,255,0.2); }
        .speed-slider { width: 120px; accent-color: #3b82f6; }
        .speed-label { font-size: 0.75rem; color: #9ca3af; }
        .speed-value { font-size: 0.75rem; color: #fff; font-family: monospace; width: 40px; }
        .info-panel {
            width: 320px;
            background: rgba(17, 24, 39, 0.95);
            backdrop-filter: blur(8px);
            border-left: 1px solid rgba(255,255,255,0.1);
            padding: 24px;
            overflow-y: auto;
            display: none;
        }
        .info-panel.active { display: block; }
        .info-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
        .info-header h2 { font-size: 1.5rem; font-weight: bold; }
        .close-btn {
            width: 32px; height: 32px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 50%; background: transparent;
            border: none; color: #9ca3af; cursor: pointer; font-size: 1.2rem;
        }
        .close-btn:hover { background: rgba(255,255,255,0.1); color: #fff; }
        .planet-visual { display: flex; justify-content: center; margin-bottom: 24px; }
        .planet-sphere { border-radius: 50%; box-shadow: 0 0 30px rgba(255,255,255,0.1); }
        .description { font-size: 0.875rem; color: #d1d5db; line-height: 1.6; margin-bottom: 24px; }
        .stat-card {
            display: flex; align-items: center; gap: 12px;
            background: rgba(255,255,255,0.05);
            border-radius: 8px; padding: 12px; margin-bottom: 12px;
        }
        .stat-icon { font-size: 1.25rem; }
        .stat-label { font-size: 0.75rem; color: #9ca3af; }
        .stat-value { font-size: 0.875rem; font-weight: 500; }
        .planet-list { margin-top: 24px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.1); }
        .planet-list h3 { font-size: 0.75rem; font-weight: 600; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px; }
        .planet-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .planet-btn {
            display: flex; align-items: center; gap: 8px;
            padding: 8px 12px; border-radius: 8px;
            background: rgba(255,255,255,0.05); border: 1px solid transparent;
            color: #d1d5db; font-size: 0.875rem; cursor: pointer;
            transition: all 0.2s;
        }
        .planet-btn:hover { background: rgba(255,255,255,0.1); }
        .planet-btn.selected { background: rgba(59,130,246,0.2); color: #93c5fd; border-color: rgba(59,130,246,0.3); }
        .planet-dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }
        .loading { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #9ca3af; }
    </style>
</head>
<body>
    <div class="header">
        <h1>🌌 Solar System Explorer</h1>
        <p>Click on any planet to learn more</p>
    </div>

    <div class="main-content">
        <div class="canvas-container">
            <canvas id="solarCanvas"></canvas>
            <div id="loading" class="loading">Loading planet data...</div>

            <div class="controls">
                <button class="btn" id="playPauseBtn" title="Play/Pause">
                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                        <path id="pauseIcon" d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
                        <path id="playIcon" d="M8 5v14l11-7z" style="display:none"/>
                    </svg>
                </button>
                <span class="speed-label">Speed:</span>
                <input type="range" class="speed-slider" id="speedSlider" min="0.1" max="5" step="0.1" value="1"/>
                <span class="speed-value" id="speedValue">1.0x</span>
            </div>
        </div>

        <div class="info-panel" id="infoPanel">
            <div class="info-header">
                <h2 id="planetName">Planet</h2>
                <button class="close-btn" id="closePanel">✕</button>
            </div>
            <div class="planet-visual">
                <div class="planet-sphere" id="planetSphere"></div>
            </div>
            <p class="description" id="planetDescription"></p>
            <div id="planetStats"></div>
            <div class="planet-list">
                <h3>All Planets</h3>
                <div class="planet-grid" id="planetGrid"></div>
            </div>
        </div>
    </div>

    <script>
        // State
        let planets = [];
        let angles = [];
        let isPlaying = true;
        let speed = 1;
        let selectedPlanet = null;
        let hoveredPlanet = null;
        let lastTime = 0;
        let stars = [];

        // Initialize
        function init() {
            // Fetch planet data from Apex controller
            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.SolarSystemController.getPlanetsJSON}',
                function(result, event) {
                    if (event.status) {
                        planets = JSON.parse(result);
                        angles = planets.map(function() { return Math.random() * Math.PI * 2; });
                        generateStars();
                        document.getElementById('loading').style.display = 'none';
                        buildPlanetList();
                        requestAnimationFrame(animate);
                    } else {
                        console.error('Error loading planets:', event.message);
                        document.getElementById('loading').textContent = 'Error loading data';
                    }
                },
                { escape: false }
            );

            // Event listeners
            document.getElementById('playPauseBtn').addEventListener('click', togglePlayPause);
            document.getElementById('speedSlider').addEventListener('input', updateSpeed);
            document.getElementById('closePanel').addEventListener('click', closePanel);
            document.getElementById('solarCanvas').addEventListener('click', handleCanvasClick);
            document.getElementById('solarCanvas').addEventListener('mousemove', handleCanvasMouseMove);
        }

        function generateStars() {
            stars = [];
            for (var i = 0; i < 200; i++) {
                stars.push({
                    x: Math.random(),
                    y: Math.random(),
                    size: Math.random() * 1.5 + 0.5,
                    opacity: Math.random() * 0.7 + 0.3
                });
            }
        }

        function togglePlayPause() {
            isPlaying = !isPlaying;
            document.getElementById('pauseIcon').style.display = isPlaying ? 'block' : 'none';
            document.getElementById('playIcon').style.display = isPlaying ? 'none' : 'block';
        }

        function updateSpeed(e) {
            speed = parseFloat(e.target.value);
            document.getElementById('speedValue').textContent = speed.toFixed(1) + 'x';
        }

        function closePanel() {
            selectedPlanet = null;
            document.getElementById('infoPanel').classList.remove('active');
            updatePlanetGrid();
        }

        function showPlanetInfo(planet) {
            selectedPlanet = planet;
            var panel = document.getElementById('infoPanel');
            panel.classList.add('active');

            document.getElementById('planetName').textContent = planet.name;
            document.getElementById('planetDescription').textContent = planet.description;

            var sphere = document.getElementById('planetSphere');
            var size = Math.min(planet.size * 3, 100);
            sphere.style.width = size + 'px';
            sphere.style.height = size + 'px';
            sphere.style.background = 'radial-gradient(circle at 35% 35%, ' + lightenColor(planet.color, 40) + ', ' + planet.color + ')';
            sphere.style.boxShadow = '0 0 30px ' + planet.color + '40';

            var statsHtml = '';
            statsHtml += statCard('📏', 'Diameter', planet.diameter.toLocaleString() + ' km');
            statsHtml += statCard('☀️', 'Distance from Sun', planet.distanceFromSun.toLocaleString() + ' million km');
            statsHtml += statCard('🔄', 'Orbital Period', formatPeriod(planet.orbitalPeriod));
            statsHtml += statCard('🌡️', 'Planet Order', planet.orderFromSun + ' from the Sun');
            document.getElementById('planetStats').innerHTML = statsHtml;

            updatePlanetGrid();

            // Log the view via Apex
            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.SolarSystemController.logPlanetView}',
                planet.name,
                function(result, event) { /* silent */ },
                { escape: false }
            );
        }

        function statCard(icon, label, value) {
            return '<div class="stat-card">' +
                '<span class="stat-icon">' + icon + '</span>' +
                '<div><p class="stat-label">' + label + '</p>' +
                '<p class="stat-value">' + value + '</p></div></div>';
        }

        function formatPeriod(days) {
            if (days < 365) return days + ' Earth days';
            var years = (days / 365.25).toFixed(1);
            return years + ' Earth years (' + days.toLocaleString() + ' days)';
        }

        function lightenColor(hex, percent) {
            var num = parseInt(hex.replace('#', ''), 16);
            var r = Math.min(255, (num >> 16) + percent);
            var g = Math.min(255, ((num >> 8) & 0xff) + percent);
            var b = Math.min(255, (num & 0xff) + percent);
            return '#' + ((r << 16) | (g << 8) | b).toString(16).padStart(6, '0');
        }

        function buildPlanetList() {
            updatePlanetGrid();
        }

        function updatePlanetGrid() {
            var grid = document.getElementById('planetGrid');
            var html = '';
            for (var i = 0; i < planets.length; i++) {
                var p = planets[i];
                var selected = selectedPlanet && selectedPlanet.name === p.name ? ' selected' : '';
                html += '<button class="planet-btn' + selected + '" data-index="' + i + '">' +
                    '<span class="planet-dot" style="background:' + p.color + '"></span>' +
                    '<span>' + p.name + '</span></button>';
            }
            grid.innerHTML = html;

            // Add click handlers
            var buttons = grid.querySelectorAll('.planet-btn');
            for (var j = 0; j < buttons.length; j++) {
                buttons[j].addEventListener('click', function() {
                    var idx = parseInt(this.getAttribute('data-index'));
                    showPlanetInfo(planets[idx]);
                });
            }
        }

        function getCanvasCoords(e) {
            var canvas = document.getElementById('solarCanvas');
            var rect = canvas.getBoundingClientRect();
            return { x: e.clientX - rect.left, y: e.clientY - rect.top };
        }

        function getPlanetPositions() {
            var canvas = document.getElementById('solarCanvas');
            var rect = canvas.getBoundingClientRect();
            var centerX = rect.width / 2;
            var centerY = rect.height / 2;
            var maxOrbit = 430;
            var availableRadius = Math.min(rect.width, rect.height) / 2 - 40;
            var scale = availableRadius / maxOrbit;

            var positions = [];
            for (var i = 0; i < planets.length; i++) {
                var p = planets[i];
                var orbitRadius = p.orbitRadius * scale;
                var x = centerX + Math.cos(angles[i]) * orbitRadius;
                var y = centerY + Math.sin(angles[i]) * orbitRadius;
                var size = Math.max(p.size * scale * 0.7, 4);
                positions.push({ x: x, y: y, size: size, planet: p, index: i });
            }
            return positions;
        }

        function handleCanvasClick(e) {
            var coords = getCanvasCoords(e);
            var positions = getPlanetPositions();

            for (var i = positions.length - 1; i >= 0; i--) {
                var pos = positions[i];
                var dist = Math.sqrt(Math.pow(coords.x - pos.x, 2) + Math.pow(coords.y - pos.y, 2));
                if (dist <= pos.size + 10) {
                    showPlanetInfo(pos.planet);
                    return;
                }
            }
            closePanel();
        }

        function handleCanvasMouseMove(e) {
            var coords = getCanvasCoords(e);
            var positions = getPlanetPositions();
            var canvas = document.getElementById('solarCanvas');
            var found = false;

            for (var i = 0; i < positions.length; i++) {
                var pos = positions[i];
                var dist = Math.sqrt(Math.pow(coords.x - pos.x, 2) + Math.pow(coords.y - pos.y, 2));
                if (dist <= pos.size + 10) {
                    hoveredPlanet = pos.planet.name;
                    canvas.style.cursor = 'pointer';
                    found = true;
                    break;
                }
            }
            if (!found) {
                hoveredPlanet = null;
                canvas.style.cursor = 'default';
            }
        }

        function animate(timestamp) {
            var canvas = document.getElementById('solarCanvas');
            var ctx = canvas.getContext('2d');
            var rect = canvas.getBoundingClientRect();
            var dpr = window.devicePixelRatio || 1;

            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
            ctx.scale(dpr, dpr);

            var width = rect.width;
            var height = rect.height;
            var centerX = width / 2;
            var centerY = height / 2;

            if (lastTime === 0) lastTime = timestamp;
            var delta = (timestamp - lastTime) / 1000;
            lastTime = timestamp;

            // Clear
            ctx.clearRect(0, 0, width, height);

            // Stars
            for (var s = 0; s < stars.length; s++) {
                var star = stars[s];
                ctx.beginPath();
                ctx.arc(star.x * width, star.y * height, star.size, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(255,255,255,' + star.opacity + ')';
                ctx.fill();
            }

            var maxOrbit = 430;
            var availableRadius = Math.min(width, height) / 2 - 40;
            var scale = availableRadius / maxOrbit;

            // Orbit paths
            for (var i = 0; i < planets.length; i++) {
                var orbitRadius = planets[i].orbitRadius * scale;
                ctx.beginPath();
                ctx.arc(centerX, centerY, orbitRadius, 0, Math.PI * 2);
                ctx.strokeStyle = 'rgba(255,255,255,0.1)';
                ctx.lineWidth = 1;
                ctx.stroke();
            }

            // Sun
            var sunGrad = ctx.createRadialGradient(centerX, centerY, 0, centerX, centerY, 35);
            sunGrad.addColorStop(0, '#fff7e6');
            sunGrad.addColorStop(0.3, '#ffcc00');
            sunGrad.addColorStop(0.7, '#ff9500');
            sunGrad.addColorStop(1, '#ff6600');
            ctx.beginPath();
            ctx.arc(centerX, centerY, 35, 0, Math.PI * 2);
            ctx.fillStyle = sunGrad;
            ctx.fill();

            // Planets
            for (var j = 0; j < planets.length; j++) {
                if (isPlaying) {
                    var angularSpeed = (2 * Math.PI) / (planets[j].orbitalPeriod * 0.01) * speed;
                    angles[j] += angularSpeed * delta;
                }

                var p = planets[j];
                var oRadius = p.orbitRadius * scale;
                var px = centerX + Math.cos(angles[j]) * oRadius;
                var py = centerY + Math.sin(angles[j]) * oRadius;
                var pSize = Math.max(p.size * scale * 0.7, 4);

                var isHovered = hoveredPlanet === p.name;
                var isSelected = selectedPlanet && selectedPlanet.name === p.name;

                if (isHovered || isSelected) {
                    ctx.beginPath();
                    ctx.arc(px, py, pSize + 6, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(255,255,255,0.2)';
                    ctx.fill();
                }

                var pGrad = ctx.createRadialGradient(px - pSize * 0.3, py - pSize * 0.3, 0, px, py, pSize);
                pGrad.addColorStop(0, lightenColor(p.color, 40));
                pGrad.addColorStop(1, p.color);
                ctx.beginPath();
                ctx.arc(px, py, pSize, 0, Math.PI * 2);
                ctx.fillStyle = pGrad;
                ctx.fill();

                // Saturn rings
                if (p.name === 'Saturn') {
                    ctx.beginPath();
                    ctx.ellipse(px, py, pSize * 1.8, pSize * 0.5, -0.3, 0, Math.PI * 2);
                    ctx.strokeStyle = 'rgba(232,213,163,0.6)';
                    ctx.lineWidth = 2;
                    ctx.stroke();
                }

                if (isHovered || isSelected) {
                    ctx.font = '12px -apple-system, sans-serif';
                    ctx.fillStyle = 'rgba(255,255,255,0.9)';
                    ctx.textAlign = 'center';
                    ctx.fillText(p.name, px, py - pSize - 8);
                }
            }

            requestAnimationFrame(animate);
        }

        // Start
        init();
    </script>
</body>
</html>
</apex:page>
